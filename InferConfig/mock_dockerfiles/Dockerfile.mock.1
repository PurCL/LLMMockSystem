# 1. Build the image:
#    DOCKER_BUILDKIT=0 docker build -t mock-env-1 -f mock_dockerfiles/Dockerfile.mock.1 /home/jian1000/data3/LLMMockSystem/exploits/task-1-new/example-t01/src/backend/
#
# 2. Run the environment (Database + App):
#    docker network create mock-net || true && docker run -d --rm --name mock-db-1 --network mock-net -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=changethis -e POSTGRES_DB=app postgres:14 && sleep 3 && docker run -d -p 8000:8000 --name mock-env-1-container --network mock-net -e DATABASE_URL="postgresql+psycopg2://postgres:changethis@mock-db-1:5432/app" mock-env-1
