FROM python:3.11-slim

WORKDIR /app

# 💡 Suppress interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system-level dependencies cleanly
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev gcc && rm -rf /var/lib/apt/lists/*

# 1. Strictly install Core Imports
RUN pip install --no-cache-dir dnspython==2.8.0 click==8.3.1 packaging==26.0 annotated-types==0.7.0 iniconfig==2.3.0 uvloop==0.22.1 playwright==1.58.0 jsonschema==4.26.0 httpx==0.28.1 cryptography==46.0.5 text-unidecode==1.3 annotated-doc==0.0.4 uvicorn==0.41.0 sniffio==1.3.1 python-slugify==8.0.4 httpx-sse==0.4.3 python-multipart==0.0.22 pydantic-settings==2.13.1 sqlmodel==0.0.37 typing_extensions==4.15.0 zstandard==0.25.0 watchfiles==1.1.1 pytest-base-url==2.1.0 pyee==13.0.1 charset-normalizer==3.4.5 jsonschema-specifications==2025.9.1 urllib3==2.6.3 anyio==4.12.1 starlette==0.52.1 websockets==16.0 httptools==0.7.1 SQLAlchemy==2.0.48 pycparser==3.0 email-validator==2.3.0 claude-agent-sdk==0.1.48 pytest-playwright==0.7.2 pluggy==1.6.0 pydantic_core==2.41.5 greenlet==3.3.2 certifi==2026.2.25 pydantic==2.12.5 fastapi==0.135.1 h11==0.16.0 rpds-py==0.30.0 httpcore==1.0.9 requests==2.32.5 typing-inspection==0.4.2 Pygments==2.19.2 mcp==1.26.0 attrs==25.4.0 referencing==0.37.0 pytest==9.0.2 cffi==2.0.0 idna==3.11 psycopg2-binary==2.9.11 sse-starlette==3.3.2

# 2. Install Mocked Imports combinations (Inferred by LLM)
RUN pip install --no-cache-dir a2wsgi==1.9.0 PyJWT==1.7.1 cython==3.2.4

# 3. Copy project files
COPY . /app/

# Default startup command
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
