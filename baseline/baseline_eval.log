"""
Automated Environment Fuzzing Harness for Vulnerability Discovery
Systematically mutates package versions to find vulnerable combinations.
"""

import json
import subprocess
import sys
import os
import shutil
import time
from pathlib import Path
from typing import Dict, List, Tuple, Optional
import itertools

# Configuration
BASELINE_REQUIREMENTS = "requirements.txt"
EXPLOIT_SCRIPT = "./exploit.sh"
OUTPUT_REPORT = "vulnerable_versions_report.json"
TEMP_DIR = Path("./fuzzing_temp")
MAX_PARALLEL_TESTS = 1  # Run tests sequentially to avoid port conflicts

# Key security-relevant packages to fuzz
# Based on the vulnerability context (JWT + Command Injection in FastAPI)
PACKAGES_TO_FUZZ = {
    "PyJWT": [
        "1.7.1",  # Known vulnerable (baseline)
        "1.7.0",
        "2.0.0",
        "2.0.1",
        "2.1.0",
        "2.2.0",
        "2.3.0",
        "2.4.0",
        "2.5.0",
        "2.6.0",
        "2.7.0",
        "2.8.0",
    ],
    "fastapi": [
        "0.135.1",  # baseline
        "0.100.0",
        "0.110.0",
        "0.115.0",
        "0.120.0",
        "0.125.0",
        "0.130.0",
    ],
    "pydantic": [
        "2.12.5",  # baseline
        "2.0.0",
        "2.5.0",
        "2.8.0",
        "2.10.0",
    ],
    "starlette": [
        "0.52.1",  # baseline
        "0.30.0",
        "0.35.0",
        "0.40.0",
        "0.45.0",
        "0.50.0",
    ],
}

class VulnerabilityFuzzer:
    def __init__(self):
        self.results = {
            "baseline_vulnerable": False,
            "total_tests": 0,
            "vulnerable_combinations": [],
            "safe_combinations": [],
            "failed_tests": [],
            "metadata": {
                "start_time": time.strftime("%Y-%m-%d %H:%M:%S"),
                "baseline_requirements": BASELINE_REQUIREMENTS,
            }
        }
        self.temp_dir = TEMP_DIR

    def setup(self):
        """Initialize the fuzzing environment"""
        print("[*] Setting up fuzzing environment...")
        self.temp_dir.mkdir(exist_ok=True)

        # Read baseline requirements
        with open(BASELINE_REQUIREMENTS, 'r') as f:
            self.baseline_reqs = f.read()

        print(f"[+] Temporary directory: {self.temp_dir}")

    def cleanup(self):
        """Remove all temporary files and virtual environments"""
        print("\n[*] Cleaning up temporary files...")

        # Remove temp directory
        if self.temp_dir.exists():
            shutil.rmtree(self.temp_dir, ignore_errors=True)
            print(f"[+] Removed {self.temp_dir}")

        # Remove any leftover venv directories
        for venv_dir in Path(".").glob("venv_test_*"):
            if venv_dir.is_dir():
                shutil.rmtree(venv_dir, ignore_errors=True)
                print(f"[+] Removed leftover venv: {venv_dir}")

        # Remove mutated requirements files
        for req_file in Path(".").glob("requirements_mutated_*.txt"):
            req_file.unlink()
            print(f"[+] Removed {req_file}")

        print("[+] Cleanup complete!")

    def parse_requirements(self, content: str) -> Dict[str, str]:
        """Parse requirements.txt into a dictionary"""
        packages = {}
        for line in content.strip().split('\n'):
            line = line.strip()
            if line and not line.startswith('#'):
                if '==' in line:
                    pkg, version = line.split('==', 1)
                    packages[pkg.strip()] = version.strip()
        return packages

    def generate_requirements(self, mutations: Dict[str, str]) -> str:
        """Generate a new requirements.txt with mutations"""
        packages = self.parse_requirements(self.baseline_reqs)

        # Apply mutations
        for pkg, version in mutations.items():
            packages[pkg] = version

        # Generate new requirements
        lines = [f"{pkg}=={ver}" for pkg, ver in packages.items()]
        return '\n'.join(lines) + '\n'

    def test_configuration(self, mutations: Dict[str, str], test_id: int) -> Tuple[bool, str, Optional[str]]:
        """
        Test a specific package configuration
        Returns: (is_vulnerable, status, error_message)
        """
        venv_name = f"venv_test_{test_id}"
        req_file = self.temp_dir / f"requirements_{test_id}.txt"

        print(f"\n[{test_id}] Testing configuration: {mutations}")

        try:
            # Generate mutated requirements
            req_content = self.generate_requirements(mutations)
            req_file.write_text(req_content)

            # Create virtual environment
            print(f"    [*] Creating virtual environment: {venv_name}")
            result = subprocess.run(
                ["python3", "-m", "venv", venv_name],
                capture_output=True,
                text=True,
                timeout=60
            )
            if result.returncode != 0:
                return False, "venv_creation_failed", result.stderr[:200]

            # Install packages
            print(f"    [*] Installing packages...")
            pip_path = f"{venv_name}/bin/pip"
            result = subprocess.run(
                [pip_path, "install", "-q", "-r", str(req_file)],
                capture_output=True,
                text=True,
                timeout=300
            )
            if result.returncode != 0:
                return False, "installation_failed", result.stderr[:200]

            # Activate venv and run exploit
            print(f"    [*] Running exploit script...")

            # Modify environment to use this venv
            env = os.environ.copy()
            env["PATH"] = f"{Path(venv_name).absolute()}/bin:{env['PATH']}"
            env["VIRTUAL_ENV"] = str(Path(venv_name).absolute())

            result = subprocess.run(
                ["bash", EXPLOIT_SCRIPT],
                capture_output=True,
                text=True,
                timeout=60,
                env=env
            )

            # Check if exploit succeeded (exit code 0 means vulnerable)
            is_vulnerable = (result.returncode == 0)

            status = "VULNERABLE" if is_vulnerable else "SAFE"
            print(f"    [{'!' if is_vulnerable else '+'}] Result: {status}")

            return is_vulnerable, status.lower(), None

        except subprocess.TimeoutExpired:
            return False, "timeout", "Test execution timed out"
        except Exception as e:
            return False, "error", str(e)[:200]
        finally:
            # Clean up venv and temp files
            if Path(venv_name).exists():
                shutil.rmtree(venv_name, ignore_errors=True)
            if req_file.exists():
                req_file.unlink()

    def test_baseline(self) -> bool:
        """Test the baseline configuration first"""
        print("\n" + "="*70)
        print("TESTING BASELINE CONFIGURATION")
        print("="*70)

        baseline_packages = self.parse_requirements(self.baseline_reqs)
        baseline_mutations = {
            pkg: ver for pkg, ver in baseline_packages.items()
            if pkg in PACKAGES_TO_FUZZ
        }

        is_vulnerable, status, error = self.test_configuration(baseline_mutations, 0)

        self.results["baseline_vulnerable"] = is_vulnerable
        self.results["total_tests"] += 1

        if not is_vulnerable:
            print("\n[!] WARNING: Baseline configuration is NOT vulnerable!")
            print("[!] This may indicate environment issues.")
        else:
            print("\n[+] Baseline confirmed vulnerable. Proceeding with fuzzing...")

        return is_vulnerable

    def run_fuzzing(self):
        """Execute the main fuzzing campaign"""
        print("\n" + "="*70)
        print("STARTING SYSTEMATIC VERSION FUZZING")
        print("="*70)

        # Strategy 1: Test single-package mutations first
        print("\n[*] Phase 1: Single-package mutations")
        test_id = 1

        for package, versions in PACKAGES_TO_FUZZ.items():
            print(f"\n[*] Fuzzing {package}...")
            baseline_packages = self.parse_requirements(self.baseline_reqs)

            for version in versions:
                # Skip if it's the baseline version
                if baseline_packages.get(package) == version:
                    continue

                mutations = {package: version}
                is_vulnerable, status, error = self.test_configuration(mutations, test_id)

                self.results["total_tests"] += 1
                result_entry = {
                    "test_id": test_id,
                    "mutations": mutations,
                    "status": status,
                    "timestamp": time.strftime("%Y-%m-%d %H:%M:%S")
                }

                if error:
                    result_entry["error"] = error

                if is_vulnerable:
                    self.results["vulnerable_combinations"].append(result_entry)
                elif status == "safe":
                    self.results["safe_combinations"].append(result_entry)
                else:
                    self.results["failed_tests"].append(result_entry)

                test_id += 1

                # Save intermediate results
                self.save_results()

        # Strategy 2: Test promising multi-package combinations
        # Focus on combinations where single mutations were vulnerable
        print("\n[*] Phase 2: Multi-package combinations (limited scope)")

        vulnerable_packages = set()
        for entry in self.results["vulnerable_combinations"]:
            vulnerable_packages.update(entry["mutations"].keys())

        if len(vulnerable_packages) >= 2:
            # Test a few multi-package combinations
            for pkg1, pkg2 in itertools.combinations(vulnerable_packages, 2):
                versions1 = [v for v in PACKAGES_TO_FUZZ.get(pkg1, [])[:3]]
                versions2 = [v for v in PACKAGES_TO_FUZZ.get(pkg2, [])[:3]]

                for v1, v2 in itertools.product(versions1, versions2):
                    mutations = {pkg1: v1, pkg2: v2}
                    is_vulnerable, status, error = self.test_configuration(mutations, test_id)

                    self.results["total_tests"] += 1
                    result_entry = {
                        "test_id": test_id,
                        "mutations": mutations,
                        "status": status,
                        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S")
                    }

                    if error:
                        result_entry["error"] = error

                    if is_vulnerable:
                        self.results["vulnerable_combinations"].append(result_entry)
                    elif status == "safe":
                        self.results["safe_combinations"].append(result_entry)
                    else:
                        self.results["failed_tests"].append(result_entry)

                    test_id += 1
                    self.save_results()

                    # Limit multi-package testing to prevent explosion
                    if test_id > 100:
                        print("[*] Reached test limit for multi-package phase")
                        break
                if test_id > 100:
                    break

    def save_results(self):
        """Save current results to JSON file"""
        self.results["metadata"]["end_time"] = time.strftime("%Y-%m-%d %H:%M:%S")

        with open(OUTPUT_REPORT, 'w') as f:
            json.dump(self.results, f, indent=2)

    def print_summary(self):
        """Print a summary of findings"""
        print("\n" + "="*70)
        print("FUZZING CAMPAIGN COMPLETE")
        print("="*70)

        print(f"\nTotal Tests Executed: {self.results['total_tests']}")
        print(f"Baseline Vulnerable: {self.results['baseline_vulnerable']}")
        print(f"Vulnerable Combinations Found: {len(self.results['vulnerable_combinations'])}")
        print(f"Safe Combinations: {len(self.results['safe_combinations'])}")
        print(f"Failed Tests: {len(self.results['failed_tests'])}")

        if self.results['vulnerable_combinations']:
            print("\n[!] VULNERABLE CONFIGURATIONS:")
            for entry in self.results['vulnerable_combinations'][:10]:
                print(f"    - Test {entry['test_id']}: {entry['mutations']}")

            if len(self.results['vulnerable_combinations']) > 10:
                print(f"    ... and {len(self.results['vulnerable_combinations']) - 10} more")

        print(f"\n[+] Full report saved to: {OUTPUT_REPORT}")

def main():
    fuzzer = VulnerabilityFuzzer()

    try:
        fuzzer.setup()

        # Test baseline first
        if not fuzzer.test_baseline():
            print("\n[!] Baseline test failed. Continuing anyway...")

        # Run fuzzing campaign
        fuzzer.run_fuzzing()

        # Print summary
        fuzzer.print_summary()

    except KeyboardInterrupt:
        print("\n\n[!] Fuzzing interrupted by user")
        fuzzer.save_results()
    except Exception as e:
        print(f"\n[!] Fatal error: {e}")
        import traceback
        traceback.print_exc()
        fuzzer.save_results()
    finally:
        # CRITICAL: Clean up all temporary files
        fuzzer.cleanup()

        print("\n[+] Fuzzing complete. Only final report remains.")

if __name__ == "__main__":
    main()

